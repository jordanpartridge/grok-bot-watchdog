#!/usr/bin/env bash
# grok-bot-ensure - keep the Grok Bot desktop app's local-exec daemon alive.
# Community-made; not affiliated with or endorsed by the app's vendor.
#
# Usage: grok-bot-ensure [--check] [--dry-run] [--force] [--verbose] [--help]
#
#   --check    report only; exit 0 healthy, 1 not healthy
#   --dry-run  show what would be done; never signals or launches anything
#   --force    skip debounce / backoff / cap (never skips the game/stream guard)
#
# Exit codes (normal mode):
#   0  healthy, idle (daemon not yet identified, or identified and alive),
#      or paused - nothing done
#   10 was unhealthy, recovered by relaunch
#   11 unhealthy but deferred (debounce, game/stream, backoff, cap,
#      clean app exit, app-down handling disabled, GBW_DAEMON_DOWN_ACTION=notify)
#   12 dry-run: would have acted
#   2  usage / config error      3  no graphical session found
#   4  app binary not found      5  relaunch attempted, still unhealthy
#   6  another instance running  7  host does not match GBW_HOST_REGEX
#
# --check and --dry-run are read-only: no lock, no state writes.
# Safe over SSH (discovers the session env itself), idempotent, never needs root.
set -uo pipefail

VERSION=0.2.0
DRY=0 CHECK=0 FORCE=0 VERBOSE=0
for a in "$@"; do
  case "$a" in
    --dry-run|-n) DRY=1 ;;
    --check)      CHECK=1 ;;
    --force)      FORCE=1 ;;
    --verbose|-v) VERBOSE=1 ;;
    --version)    echo "$VERSION"; exit 0 ;;
    -h|--help)    awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) echo "unknown arg: $a" >&2; exit 2 ;;
  esac
done

# ---- configuration ----------------------------------------------------------
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/grok-bot-watchdog"
CONF="${GBW_CONFIG:-$CONF_DIR/config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/grok-bot-watchdog"
# shellcheck disable=SC1090
if [[ -r "$CONF" ]]; then . "$CONF" || { echo "bad config: $CONF" >&2; exit 2; }; fi

: "${GBW_HOST_REGEX:=}"                   # refuse to run unless hostname matches
: "${GBW_PAUSE_FILES:=$CONF_DIR/PAUSE:$STATE/PAUSE}"   # colon separated
: "${GBW_APP_BIN:=}"                      # auto-detected if empty
: "${GBW_APP_DATA:=${XDG_CONFIG_HOME:-$HOME/.config}/Grok Bot}"  # Electron user-data dir
: "${GBW_DAEMON_MATCH:=}"                 # regex for a standalone daemon cmdline (older builds)
: "${GBW_DAEMON_FD_MARKER:=/terminals/[0-9]+\.txt$}"  # regex for files the daemon holds open
: "${GBW_LAUNCH_CMD:=}"                   # custom launch command (run via sh -c)
: "${GBW_RELAUNCH_IF_MAIN_DOWN:=0}"       # 1 = also start the app when it is not running
: "${GBW_DAEMON_DOWN_ACTION:=relaunch}"   # relaunch | notify
: "${GBW_DEBOUNCE:=2}"                    # consecutive unhealthy checks before acting
: "${GBW_BACKOFF_BASE:=300}"              # seconds; doubles with each recent relaunch
: "${GBW_CAP:=3}"                         # max relaunches per window
: "${GBW_CAP_WINDOW:=3600}"
: "${GBW_TERM_WAIT:=10}"
: "${GBW_SETTLE:=30}"
: "${GBW_GAME_GUARD:=1}"
: "${GBW_GAME_PROCS:=gamescope|vrserver|vrcompositor}"   # exact process names
: "${GBW_GAME_MATCH:=^[^ ]*/reaper SteamLaunch }"         # cmdline regex
: "${GBW_STREAM_GUARD:=1}"
: "${GBW_SUNSHINE_LOG:=${XDG_CONFIG_HOME:-$HOME/.config}/sunshine/sunshine.log}"
: "${GBW_STREAM_PORTS:=47998|47999|48000|48002|48010}"   # Sunshine/GameStream UDP/TCP
: "${GBW_NOTIFY:=1}"
: "${GBW_BLOCK_NOTIFY:=1800}"             # notify once when a guard blocks longer than this

UID_="$(id -u)"
RO=$(( CHECK || DRY ))   # read-only modes: no lock, no state writes
(( RO )) || mkdir -p "$STATE"
LOG="$STATE/ensure.log"
ts()  { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { (( RO )) || printf '%s %s\n' "$(ts)" "$*" >>"$LOG"; printf '%s\n' "$*"; }
dbg() { (( VERBOSE )) && printf 'debug: %s\n' "$*" >&2; return 0; }
re_escape() { printf '%s' "$1" | sed 's/[][\.^$*+?(){}|/]/\\&/g'; }
notify() {
  (( GBW_NOTIFY && ! RO )) || return 0
  command -v notify-send >/dev/null 2>&1 && notify-send -a grok-bot-watchdog "Grok Bot watchdog" "$1" >/dev/null 2>&1
  return 0
}

# ---- host / lock / pause ----------------------------------------------------
if [[ -n "$GBW_HOST_REGEX" ]]; then
  host="$(hostname -s 2>/dev/null || hostname)"
  [[ "$host" =~ $GBW_HOST_REGEX ]] || { echo "refuse: host does not match GBW_HOST_REGEX" >&2; exit 7; }
fi
if (( ! RO )); then
  exec 9>"$STATE/lock"
  flock -n 9 || { echo "status=locked"; exit 6; }
fi
IFS=: read -r -a _pauses <<<"$GBW_PAUSE_FILES"
for p in "${_pauses[@]}"; do
  [[ -n "$p" && -e "$p" ]] && { log "status=paused file=$p"; exit 0; }
done

# ---- locate the app ---------------------------------------------------------
find_app() {
  [[ -n "$GBW_APP_BIN" ]] && { [[ -x "$GBW_APP_BIN" ]] && readlink -f "$GBW_APP_BIN"; return; }
  local c
  for c in "/opt/Grok Bot/grok-bot" /opt/grok-bot/grok-bot /usr/lib/grok-bot/grok-bot \
           "$HOME/.local/opt/Grok Bot/grok-bot" "$(command -v grok-bot 2>/dev/null)"; do
    [[ -n "$c" && -x "$c" ]] && { readlink -f "$c"; return; }
  done
  return 1
}
APP="$(find_app)"
[[ -n "$APP" ]] || { echo "status=no_app (set GBW_APP_BIN)" >&2; exit 4; }
COMM="$(basename "$APP" | cut -c1-15)"
dbg "app=$APP"

# Is PID an instance of $APP? Compare the real executable; when /proc/PID/exe
# is unreadable (e.g. inside the hardened unit's user namespace) require the
# command line to BEGIN with "$APP" followed by a space/NUL or the end (Electron
# rewrites argv into one space-joined string). Substring matches never count,
# so an editor or pager showing the path is never mistaken for the app.
is_app() {
  local exe c
  if exe="$(readlink "/proc/$1/exe" 2>/dev/null)"; then
    [[ "$exe" == "$APP" ]]; return
  fi
  c="$(tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null)"
  [[ "$c" == "$APP" || "$c" == "$APP "* ]]
}
# All processes of THIS user that are the app (main + Chromium helpers).
app_pids() {
  local p
  for p in $(pgrep -u "$UID_" -x -- "$(re_escape "$COMM")" 2>/dev/null); do
    is_app "$p" && echo "$p"
  done
}
cmdline() { tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null; }
main_pids() {
  local p c
  for p in $(app_pids); do
    c="$(cmdline "$p")"; [[ -n "$c" && "$c" != *" --type="* ]] && echo "$p"
  done
}
nodeservice_children() {
  local p
  for p in $(pgrep -u "$UID_" -P "$1" 2>/dev/null); do
    is_app "$p" || continue
    [[ "$(cmdline "$p")" == *"--utility-sub-type=node.mojom.NodeService"* ]] && echo "$p"
  done
}
# Daemon = the NodeService child carrying a local-exec marker: it has child
# processes (shells it runs), or holds a terminal-output file open, or a
# standalone process matches GBW_DAEMON_MATCH (user-scoped, anchored).
daemon_marker() {
  local p="$1" f
  [[ -n "$(pgrep -u "$UID_" -P "$p" 2>/dev/null)" ]] && { echo children; return 0; }
  for f in /proc/"$p"/fd/*; do
    f="$(readlink "$f" 2>/dev/null)" || continue
    [[ "$f" =~ $GBW_DAEMON_FD_MARKER ]] && { echo fd; return 0; }
  done
  return 1
}
standalone_daemon() {
  [[ -n "$GBW_DAEMON_MATCH" ]] && pgrep -u "$UID_" -f -- "^[^ ]*($GBW_DAEMON_MATCH)" 2>/dev/null | head -1
  return 0
}

# ---- guards -------------------------------------------------------------------
game_running() {
  (( GBW_GAME_GUARD )) || return 1
  pgrep -u "$UID_" -x -- "$GBW_GAME_PROCS" >/dev/null 2>&1 ||
    pgrep -u "$UID_" -f -- "$GBW_GAME_MATCH" >/dev/null 2>&1
}
# An active Sunshine stream. Sunshine itself runs all the time, so require:
# sunshine is running for this user, its log was written after it started
# (not a stale log from an earlier run), and the last connect/disconnect line
# is a connect. Or: a stream port has an established/connected peer.
proc_start_epoch() {  # wall-clock start time of PID (via ps etimes)
  local e; e="$(ps -o etimes= -p "$1" 2>/dev/null | tr -d ' ')"
  [[ "$e" =~ ^[0-9]+$ ]] && echo $(( $(date +%s) - e ))
}
stream_active() {
  (( GBW_STREAM_GUARD )) || return 1
  local sp st mt last
  sp="$(pgrep -u "$UID_" -x sunshine 2>/dev/null | head -1)"
  [[ -n "$sp" ]] || sp="$(pgrep -x sunshine 2>/dev/null | head -1)"
  [[ -n "$sp" ]] || return 1
  if [[ -r "$GBW_SUNSHINE_LOG" ]]; then
    st="$(proc_start_epoch "$sp")"; mt="$(stat -c %Y "$GBW_SUNSHINE_LOG" 2>/dev/null)"
    if [[ -n "$st" && -n "$mt" ]] && (( mt >= st )); then
      last="$(grep -a -E 'CLIENT (DIS)?CONNECTED' "$GBW_SUNSHINE_LOG" 2>/dev/null | tail -1)"
      [[ "$last" == *"CLIENT CONNECTED"* ]] && return 0
    fi
  fi
  command -v ss >/dev/null 2>&1 || return 1
  # With a state filter ss prints no State column:
  #   Netid Recv-Q Send-Q Local:Port Peer:Port
  ss -Htun state established 2>/dev/null |
    awk -v re=":($GBW_STREAM_PORTS)\$" '$4 ~ re || $5 ~ re {found=1} END{exit !found}'
}
# Returns 0 (and prints why) if a relaunch must not happen right now.
# Notifies once if a guard has been blocking for more than GBW_BLOCK_NOTIFY s.
guard_blocks() {
  local why="" since
  if game_running; then why=game_running
  elif stream_active; then why=stream_active; fi
  if [[ -z "$why" ]]; then
    (( RO )) || rm -f "$STATE/blocked-since" "$STATE/blocked-notified"
    return 1
  fi
  if (( ! RO )); then
    [[ -s "$STATE/blocked-since" ]] || date +%s >"$STATE/blocked-since"
    since="$(cat "$STATE/blocked-since" 2>/dev/null)"
    if [[ "$since" =~ ^[0-9]+$ ]] && (( $(date +%s) - since > GBW_BLOCK_NOTIFY )) && [[ ! -e "$STATE/blocked-notified" ]]; then
      notify "Local-exec daemon is down but a relaunch has been held off for over $(( GBW_BLOCK_NOTIFY / 60 )) min ($why)."
      touch "$STATE/blocked-notified"
    fi
  fi
  echo "$why"
}

# ---- session discovery (works from SSH / systemd with an empty env) ----------
SESSION=none
discover_session() {
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID_}"
  local rt="$XDG_RUNTIME_DIR" s sid type desk donor="" d kv k
  [[ -d "$rt" ]] || return 1
  for d in $(main_pids 2>/dev/null | head -1) \
           $(pgrep -u "$UID_" -x 'Hyprland|gnome-shell|kwin_wayland|kwin_x11|plasmashell|sway|xfce4-session' 2>/dev/null); do
    [[ -r "/proc/$d/environ" ]] && { donor="$d"; break; }
  done
  if [[ -n "$donor" ]]; then
    dbg "env donor pid=$donor"
    while IFS= read -r -d '' kv; do
      k="${kv%%=*}"
      case "$k" in
        WAYLAND_DISPLAY|DISPLAY|XAUTHORITY|HYPRLAND_INSTANCE_SIGNATURE|SWAYSOCK|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP|XDG_SESSION_DESKTOP|DBUS_SESSION_BUS_ADDRESS|DESKTOP_SESSION)
          [[ -z "${!k:-}" ]] && export "${kv?}" ;;
      esac
    done <"/proc/$donor/environ"
  fi
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -d "$rt/hypr" ]]; then
    # shellcheck disable=SC2012  # newest socket wins; names are hex
    s="$(ls -t "$rt"/hypr/*/.socket.sock 2>/dev/null | head -1)"
    [[ -n "$s" ]] && { s="${s%/.socket.sock}"; export HYPRLAND_INSTANCE_SIGNATURE="${s##*/}"; }
  fi
  if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for s in "$rt"/wayland-[0-9]*; do [[ -S "$s" ]] && { export WAYLAND_DISPLAY="${s##*/}"; break; }; done
  fi
  if [[ -z "${DISPLAY:-}" ]]; then
    for s in /tmp/.X11-unix/X*; do [[ -S "$s" ]] && { s="${s##*/}"; export DISPLAY=":${s#X}"; break; }; done
  fi
  [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "$rt/bus" ]] && export DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus"
  if [[ -z "${XDG_SESSION_TYPE:-}" ]] && command -v loginctl >/dev/null 2>&1; then
    for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -un)" '$3==u{print $1}'); do
      type="$(loginctl show-session "$sid" -p Type --value 2>/dev/null)"
      desk="$(loginctl show-session "$sid" -p Desktop --value 2>/dev/null)"
      if [[ "$type" == wayland || "$type" == x11 ]]; then
        export XDG_SESSION_TYPE="$type"
        [[ -n "$desk" && -z "${XDG_CURRENT_DESKTOP:-}" ]] && export XDG_CURRENT_DESKTOP="$desk"
        break
      fi
    done
  fi
  [[ -z "${XDG_SESSION_TYPE:-}" && -n "${WAYLAND_DISPLAY:-}" ]] && export XDG_SESSION_TYPE=wayland
  [[ -z "${XDG_SESSION_TYPE:-}" && -n "${DISPLAY:-}" ]] && export XDG_SESSION_TYPE=x11
  if   [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]];   then SESSION=hyprland
  elif [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]];   then SESSION=gnome
  elif [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]];     then SESSION=kde
  elif [[ -n "${SWAYSOCK:-}" ]];                      then SESSION=sway
  else SESSION="${XDG_SESSION_TYPE:-none}"; fi
  [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]
}

SESSION_VARS=(WAYLAND_DISPLAY DISPLAY XAUTHORITY HYPRLAND_INSTANCE_SIGNATURE XDG_SESSION_TYPE XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS)
push_env_to_manager() {
  local set=() v
  for v in "${SESSION_VARS[@]}"; do [[ -n "${!v:-}" ]] && set+=("$v"); done
  ((${#set[@]})) || return 0
  systemctl --user import-environment "${set[@]}" >/dev/null 2>&1 || true
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd "${set[@]}" >/dev/null 2>&1 || true
  fi
}

# Called only after the guards passed; the attempt is counted toward the
# cap/backoff right here, when a launch is actually made.
record_relaunch() {
  date +%s >>"$STATE/relaunches"
  tail -n 20 "$STATE/relaunches" >"$STATE/relaunches.tmp" && mv "$STATE/relaunches.tmp" "$STATE/relaunches"
}
launch_app() {
  if [[ -n "$GBW_LAUNCH_CMD" ]]; then
    record_relaunch
    sh -c "$GBW_LAUNCH_CMD" >>"$STATE/app.log" 2>&1 </dev/null
    return
  fi
  local flags=() envs=() v
  if [[ "${XDG_SESSION_TYPE:-}" == wayland ]]; then
    # shellcheck disable=SC2054  # commas are part of the flag value
    flags=(--ozone-platform=wayland --enable-features=UseOzonePlatform,WaylandWindowDecorations --enable-wayland-ime)
  fi
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    # Started by the user manager as its own unit: outside this service's
    # sandbox, and stopping the watchdog never takes the app down.
    for v in "${SESSION_VARS[@]}"; do [[ -n "${!v:-}" ]] && envs+=("--setenv=$v=${!v}"); done
    record_relaunch
    systemd-run --user --quiet --collect --unit="grok-bot-app-$(date +%s)" \
      -p KillMode=process "${envs[@]}" -- "$APP" "${flags[@]}" >>"$STATE/app.log" 2>&1
  elif [[ -n "${INVOCATION_ID:-}" ]]; then
    # Inside a systemd unit (the hardened watchdog service): a setsid child
    # would inherit its read-only sandbox, so refuse instead.
    log "refuse: no user manager for systemd-run and running inside a unit sandbox; set GBW_LAUNCH_CMD"
    return 1
  else
    record_relaunch
    setsid "$APP" "${flags[@]}" >>"$STATE/app.log" 2>&1 </dev/null &
    disown 2>/dev/null || true
  fi
}

stop_app_graceful() {
  local i pids
  mapfile -t pids < <(main_pids)
  ((${#pids[@]})) || return 0
  kill -TERM "${pids[@]}" 2>/dev/null || true
  for ((i = 0; i < GBW_TERM_WAIT; i++)); do
    [[ -z "$(main_pids)" ]] && return 0
    sleep 1
  done
  return 1
}

# Healthy = main up and a NodeService child with a local-exec marker (or a
# matching standalone daemon). Sets MAIN, DAEMON, HOW, NS_COUNT.
probe() {
  MAIN="$(main_pids 2>/dev/null | head -1)"; DAEMON="" HOW="" NS_COUNT=0
  local c m s
  s="$(standalone_daemon)"
  [[ -n "$s" ]] && { DAEMON="$s"; HOW=standalone; }
  [[ -z "$MAIN" ]] && { [[ -n "$DAEMON" ]]; return; }
  for c in $(nodeservice_children "$MAIN"); do
    NS_COUNT=$((NS_COUNT + 1))
    if [[ -z "$DAEMON" ]] && m="$(daemon_marker "$c")"; then DAEMON="$c"; HOW="$m"; fi
  done
  [[ -n "$DAEMON" ]]
}
# After a relaunch the new daemon is usually idle (no shells yet, so no
# marker). Accept a NEW main process (not OLD_MAIN) with a NodeService child;
# the daemon's identity is recorded on a later run once it shows a marker.
wait_healthy() {
  local i
  for ((i = 0; i < GBW_SETTLE; i++)); do
    probe && return 0
    [[ -n "$MAIN" && "$MAIN" != "${OLD_MAIN:-}" ]] && (( NS_COUNT >= 1 )) && return 0
    sleep 1
  done
  return 1
}

# ---- health check -------------------------------------------------------------
FAILS_F="$STATE/fails" ID_F="$STATE/daemon-identity"
# Start time of PID in clock ticks since boot: /proc/PID/stat field 22
# (parsed after the ")" that ends the comm field, which may contain spaces).
proc_starttime() {
  local s; s="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  s="${s##*) }"; read -r -a f <<<"$s"; echo "${f[19]}"
}
# Identity tracking. When a process is positively identified as the daemon
# (marker present) we record:  <main pid> <main start> <daemon pid> <daemon start>
# Later, with no marker visible (idle daemon), the daemon counts as down only
# if THAT recorded process is gone, or its PID now has a different start time,
# while the same main instance is still running. Before any identification
# for the current main instance it is never called down.
probe; healthy=$?
(( RO )) || rm -f "$STATE/nodeservice-baseline"   # obsolete count baseline
if (( healthy == 0 )); then
  if (( ! RO )); then
    echo 0 >"$FAILS_F"; rm -f "$STATE/cap-notified" "$STATE/daemon-down-notified"
    echo "${MAIN:--} $( [[ -n "$MAIN" ]] && proc_starttime "$MAIN" || echo -) $DAEMON $(proc_starttime "$DAEMON")" >"$ID_F"
  fi
  echo "status=ok main=$MAIN daemon=$DAEMON via=$HOW"
  exit 0
fi

if [[ -z "$MAIN" ]]; then
  reason=app_down
else
  m_start="$(proc_starttime "$MAIN")"
  i_main="" i_mstart="" i_d="" i_dstart=""
  if [[ -r "$ID_F" ]]; then read -r i_main i_mstart i_d i_dstart <"$ID_F" || true; fi
  if [[ "$i_main" != "$MAIN" || -z "$m_start" || "$i_mstart" != "$m_start" || ! "$i_d" =~ ^[0-9]+$ ]]; then
    (( RO )) || echo 0 >"$FAILS_F"
    echo "status=ok_idle main=$MAIN daemon=unidentified (no marker yet for this app instance; never called down)"
    exit 0
  fi
  if [[ "$(proc_starttime "$i_d")" == "$i_dstart" ]]; then
    (( RO )) || echo 0 >"$FAILS_F"
    echo "status=ok_idle main=$MAIN daemon=$i_d (identified earlier, alive, idle)"
    exit 0
  fi
  reason=daemon_down
  log "daemon pid $i_d (recorded for main $MAIN) is gone or its PID was reused"
fi
(( CHECK )) && { echo "status=unhealthy reason=$reason"; exit 1; }

if [[ "$reason" == app_down ]]; then
  if [[ "$GBW_RELAUNCH_IF_MAIN_DOWN" != 1 ]]; then
    log "status=deferred reason=app_down (GBW_RELAUNCH_IF_MAIN_DOWN=0)"; exit 11
  fi
  # Electron removes SingletonLock on a clean quit; a leftover lock means a crash/kill.
  if [[ ! -L "$GBW_APP_DATA/SingletonLock" ]]; then
    log "status=deferred reason=clean_exit (app was quit intentionally)"; exit 11
  fi
fi

if [[ "$reason" == daemon_down && "$GBW_DAEMON_DOWN_ACTION" == notify ]]; then
  if (( ! RO )) && [[ ! -e "$STATE/daemon-down-notified" ]]; then
    discover_session >/dev/null 2>&1 || true
    notify "Grok Bot local-exec daemon is down (app still running). Restart the app to reconnect."
    touch "$STATE/daemon-down-notified"
  fi
  log "status=deferred reason=daemon_down action=notify"; exit 11
fi

fails=$(( $(cat "$FAILS_F" 2>/dev/null || echo 0) + 1 ))
(( DRY )) || echo "$fails" >"$FAILS_F"
if (( fails < GBW_DEBOUNCE && FORCE == 0 && DRY == 0 )); then
  log "unhealthy reason=$reason check=$fails/$GBW_DEBOUNCE - waiting for next run"
  log "status=deferred reason=debounce"; exit 11
fi
if why="$(guard_blocks)"; then
  log "unhealthy reason=$reason but $why - not relaunching"
  log "status=deferred reason=$why"; exit 11
fi

# relaunch cap + exponential backoff
now=$(date +%s) recent=0 last=0
if [[ -f "$STATE/relaunches" ]]; then
  while read -r t; do
    [[ "$t" =~ ^[0-9]+$ ]] || continue
    (( now - t < GBW_CAP_WINDOW )) && recent=$((recent + 1))
    (( t > last )) && last=$t
  done <"$STATE/relaunches"
fi
if (( FORCE == 0 )); then
  if (( recent >= GBW_CAP )); then
    log "cap reached ($recent relaunches in ${GBW_CAP_WINDOW}s) - backing off"
    if [[ ! -e "$STATE/cap-notified" ]] && (( ! DRY )); then
      discover_session >/dev/null 2>&1 || true
      notify "Local-exec daemon keeps dropping; relaunch cap ($GBW_CAP/${GBW_CAP_WINDOW}s) hit. Watchdog is backing off."
      touch "$STATE/cap-notified"
    fi
    log "status=deferred reason=cap"; exit 11
  fi
  if (( recent > 0 )); then
    wait_s=$(( GBW_BACKOFF_BASE * (1 << (recent - 1)) ))
    if (( now - last < wait_s )); then
      log "status=deferred reason=backoff next_in=$(( wait_s - (now - last) ))s"; exit 11
    fi
  fi
fi

discover_session || { log "no graphical session found for uid $UID_"; echo "status=no_session" >&2; exit 3; }
dbg "session=$SESSION type=${XDG_SESSION_TYPE:-} wayland=${WAYLAND_DISPLAY:-} display=${DISPLAY:-}"

if (( DRY )); then
  echo "dry-run: reason=$reason session=$SESSION"
  [[ "$reason" == daemon_down ]] && echo "dry-run: would SIGTERM app pid $MAIN, then SIGKILL its tree if needed"
  echo "dry-run: would import session env and relaunch: ${GBW_LAUNCH_CMD:-$APP}"
  exit 12
fi

OLD_MAIN="$MAIN"
push_env_to_manager
log "recover: reason=$reason session=$SESSION"

# Tier 1: graceful stop (if running) + relaunch with a fixed env.
if [[ "$reason" == daemon_down ]]; then
  if why="$(guard_blocks)"; then log "abort before stop: $why"; log "status=deferred reason=$why"; exit 11; fi
  stop_app_graceful || log "graceful stop timed out"
fi
if [[ -z "$(main_pids)" ]]; then
  if why="$(guard_blocks)"; then log "abort before launch: $why"; log "status=deferred reason=$why"; exit 11; fi
  launch_app || { echo "status=failed reason=launch_refused" >&2; exit 5; }
fi
if wait_healthy; then
  echo 0 >"$FAILS_F"; log "recovered (tier1)"; echo "status=recovered reason=$reason"; exit 10
fi

# Tier 2: hard relaunch. Re-check the guards right before the kill.
if why="$(guard_blocks)"; then log "abort before hard kill: $why"; log "status=deferred reason=$why"; exit 11; fi
log "tier1 failed; hard relaunch"
mapfile -t all < <(app_pids)
((${#all[@]})) && kill -KILL "${all[@]}" 2>/dev/null
sleep 2
if why="$(guard_blocks)"; then log "abort before launch: $why"; log "status=deferred reason=$why"; exit 11; fi
launch_app || { echo "status=failed reason=launch_refused" >&2; exit 5; }
if wait_healthy; then
  echo 0 >"$FAILS_F"; log "recovered (tier2 hard)"; echo "status=recovered reason=$reason tier=hard"; exit 10
fi
log "FAILED: daemon not healthy after hard relaunch"
notify "Could not bring the local-exec daemon back (see $LOG)."
echo "status=failed reason=$reason" >&2
exit 5
