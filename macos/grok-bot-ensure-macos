#!/usr/bin/env bash
# grok-bot-ensure-macos - UNTESTED macOS port of the Linux watchdog.
# Community-made; not affiliated with or endorsed by the app's vendor.
#
# Usage: grok-bot-ensure-macos [--check] [--dry-run] [--force]
# Exit codes match the Linux script: 0 ok, 10 recovered, 11 deferred,
# 12 dry-run, 2 usage, 4 app not found, 5 failed, 6 locked, 7 host mismatch;
# --check: 0 healthy, 1 not healthy.
set -uo pipefail
DRY=0 FORCE=0 CHECK=0
for a in "$@"; do
  case "$a" in
    --dry-run|-n) DRY=1 ;;
    --check) CHECK=1 ;;
    --force) FORCE=1 ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $a" >&2; exit 2 ;;
  esac
done

CONF_DIR="$HOME/.config/grok-bot-watchdog"
STATE="$HOME/Library/Application Support/grok-bot-watchdog"
LOGDIR="$HOME/Library/Logs/grok-bot-watchdog"
# shellcheck disable=SC1091
[[ -r "$CONF_DIR/config" ]] && . "$CONF_DIR/config"
: "${GBW_HOST_REGEX:=}"
: "${GBW_PAUSE_FILES:=$CONF_DIR/PAUSE:$STATE/PAUSE}"
: "${GBW_APP_NAME:=Grok Bot}"
: "${GBW_APP_PATH:=/Applications/$GBW_APP_NAME.app}"
: "${GBW_RELAUNCH_IF_MAIN_DOWN:=0}"
: "${GBW_DEBOUNCE:=2}" "${GBW_CAP:=3}" "${GBW_CAP_WINDOW:=3600}" "${GBW_BACKOFF_BASE:=300}"
: "${GBW_TERM_WAIT:=10}" "${GBW_SETTLE:=30}" "${GBW_BLOCK_NOTIFY:=1800}"
: "${GBW_GAME_GUARD:=1}"
# Steam games (run from steamapps), Steam's launcher, Wine/CrossOver/Whisky
# (wine processes only exist while a Windows program runs), common launchers.
: "${GBW_GAME_MATCH:=/steamapps/common/|SteamLaunch|wine64-preloader|wineserver|/CrossOver\.app/|/Whisky\.app/|Battle\.net|EpicGamesLauncher|GOG Galaxy|Heroic|Prism ?Launcher|PrismLauncher}"
: "${GBW_STREAM_GUARD:=1}"
# Sunshine uses ~/.config/sunshine on macOS too (its log is sunshine.log there).
: "${GBW_SUNSHINE_LOG:=$HOME/.config/sunshine/sunshine.log}"
: "${GBW_DAEMON_FD_MARKER:=/terminals/[0-9]+\.txt$}"
mkdir -p "$STATE" "$LOGDIR"
LOG="$LOGDIR/ensure.log"
log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG"; echo "$*"; }
notify() {
  local m="${1//\\/\\\\}"; m="${m//\"/\\\"}"
  osascript -e "display notification \"$m\" with title \"Grok Bot watchdog\"" >/dev/null 2>&1 || true
}

if [[ -n "$GBW_HOST_REGEX" ]]; then
  [[ "$(hostname -s)" =~ $GBW_HOST_REGEX ]] || { echo "refuse: host mismatch" >&2; exit 7; }
fi

# mkdir lock with owner PID + age check so a crashed run can't wedge it.
LOCK="$STATE/lock.d"
if ! mkdir "$LOCK" 2>/dev/null; then
  owner="$(cat "$LOCK/pid" 2>/dev/null || echo)"
  age=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || date +%s) ))
  if [[ -n "$owner" ]] && kill -0 "$owner" 2>/dev/null && (( age < 600 )); then
    echo "status=locked"; exit 6
  fi
  rm -rf "$LOCK"; mkdir "$LOCK" || { echo "status=locked"; exit 6; }
fi
echo $$ >"$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT

IFS=: read -r -a _p <<<"$GBW_PAUSE_FILES"
for p in "${_p[@]}"; do [[ -n "$p" && -e "$p" ]] && { echo "status=paused file=$p"; (( CHECK )) && exit 0; exit 11; }; done
[[ -d "$GBW_APP_PATH" ]] || { echo "status=no_app ($GBW_APP_PATH)" >&2; exit 4; }
BINDIR="$GBW_APP_PATH/Contents/MacOS"
UID_="$(id -u)"

main_pid() {
  local p c
  for p in $(pgrep -U "$UID_" -x "$GBW_APP_NAME" 2>/dev/null); do
    c="$(ps -o command= -p "$p")"
    [[ ( "$c" == "$BINDIR/"* ) && "$c" != *" --type="* ]] && { echo "$p"; return; }
  done
}
nodeservice_children() {
  local p
  for p in $(pgrep -U "$UID_" -P "$1" 2>/dev/null); do
    ps -o command= -p "$p" | grep -q -- '--utility-sub-type=node.mojom.NodeService' && echo "$p"
  done
}
has_marker() {
  [[ -n "$(pgrep -P "$1")" ]] && return 0
  lsof -Fn -p "$1" 2>/dev/null | sed -n 's/^n//p' | grep -Eq "$GBW_DAEMON_FD_MARKER"
}
instance_id() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' '_'; }
probe() {
  M="$(main_pid)"; D="" NS=0
  [[ -n "$M" ]] || return 1
  local c
  for c in $(nodeservice_children "$M"); do
    NS=$((NS + 1))
    [[ -z "$D" ]] && has_marker "$c" && D="$c"
  done
  [[ -n "$D" ]]
}
sunshine_streaming() {
  (( GBW_STREAM_GUARD )) || return 1
  local sp el st mt last
  sp="$(pgrep -x -i sunshine | head -1)"; [[ -n "$sp" ]] || return 1
  [[ -r "$GBW_SUNSHINE_LOG" ]] || return 1
  el="$(ps -o etime= -p "$sp" | tr -d ' ')"   # [[dd-]hh:]mm:ss
  st=$(( $(date +%s) - $(awk -F'[-:]' '{n=NF; s=$n+$(n-1)*60; if(n>2)s+=$(n-2)*3600; if(n>3)s+=$(n-3)*86400; print s}' <<<"$el") ))
  mt="$(stat -f %m "$GBW_SUNSHINE_LOG")"
  (( mt >= st )) || return 1
  last="$(grep -a -E 'CLIENT (DIS)?CONNECTED' "$GBW_SUNSHINE_LOG" | tail -1)"
  [[ "$last" == *"CLIENT CONNECTED"* ]]
}
guard_blocks() {
  local why="" since
  if (( GBW_GAME_GUARD )) && pgrep -U "$UID_" -f "$GBW_GAME_MATCH" >/dev/null; then why=game_running
  elif sunshine_streaming; then why=stream_active; fi
  if [[ -z "$why" ]]; then rm -f "$STATE/blocked-since" "$STATE/blocked-notified"; return 1; fi
  if (( ! DRY )); then
    [[ -s "$STATE/blocked-since" ]] || date +%s >"$STATE/blocked-since"
    since="$(cat "$STATE/blocked-since")"
    if [[ "$since" =~ ^[0-9]+$ ]] && (( $(date +%s) - since > GBW_BLOCK_NOTIFY )) && [[ ! -e "$STATE/blocked-notified" ]]; then
      notify "Relaunch held off for over $(( GBW_BLOCK_NOTIFY / 60 )) min ($why)."; touch "$STATE/blocked-notified"
    fi
  fi
  echo "$why"
}
record_relaunch() { date +%s >>"$STATE/relaunches"; tail -n 20 "$STATE/relaunches" >"$STATE/r.tmp" && mv "$STATE/r.tmp" "$STATE/relaunches"; }
defer() { log "deferred: $1"; echo "status=deferred reason=$1"; exit 11; }

BASE_F="$STATE/nodeservice-baseline"
if probe; then
  echo 0 >"$STATE/fails"; rm -f "$STATE/cap-notified"
  echo "$NS $M $(instance_id "$M")" >"$BASE_F"
  echo "status=ok main=$M daemon=$D"; exit 0
fi
if [[ -n "$M" ]]; then
  base=0; read -r b_count b_pid b_inst <"$BASE_F" 2>/dev/null || true
  [[ "${b_count:-}" =~ ^[0-9]+$ && "${b_pid:-}" == "$M" && "${b_inst:-}" == "$(instance_id "$M")" ]] && base=$b_count
  if (( base == 0 || NS >= base )); then
    echo 0 >"$STATE/fails"; echo "status=ok_idle main=$M nodeservice=$NS baseline=$base"; exit 0
  fi
  reason=daemon_down
else
  reason=app_down
fi
(( CHECK )) && { echo "status=unhealthy reason=$reason"; exit 1; }
[[ $reason == app_down && "$GBW_RELAUNCH_IF_MAIN_DOWN" != 1 ]] && { echo "status=deferred reason=app_down"; exit 11; }

fails=$(( $(cat "$STATE/fails" 2>/dev/null || echo 0) + 1 ))
(( DRY )) || echo "$fails" >"$STATE/fails"
(( fails < GBW_DEBOUNCE && FORCE == 0 && DRY == 0 )) && defer debounce
if why="$(guard_blocks)"; then defer "$why"; fi

now=$(date +%s) recent=0 last=0
if [[ -f "$STATE/relaunches" ]]; then
  while read -r t; do
    [[ "$t" =~ ^[0-9]+$ ]] || continue
    (( now - t < GBW_CAP_WINDOW )) && recent=$((recent + 1)); (( t > last )) && last=$t
  done <"$STATE/relaunches"
fi
if (( FORCE == 0 )); then
  if (( recent >= GBW_CAP )); then
    [[ -e "$STATE/cap-notified" ]] || { notify "Relaunch cap hit; backing off."; touch "$STATE/cap-notified"; }
    defer cap
  fi
  (( recent > 0 && now - last < GBW_BACKOFF_BASE * (1 << (recent - 1)) )) && defer backoff
fi
(( DRY )) && { echo "dry-run: reason=$reason; would quit (if running) and 'open -g -a \"$GBW_APP_PATH\"'"; exit 12; }

OLD="$M"; want="${b_count:-1}"; [[ "$want" =~ ^[1-9][0-9]*$ ]] || want=1
log "recover: $reason"
if [[ $reason == daemon_down ]]; then
  if why="$(guard_blocks)"; then defer "$why"; fi
  osascript -e "tell application \"$GBW_APP_NAME\" to quit" >/dev/null 2>&1 || kill -TERM "$M" 2>/dev/null
  for ((i = 0; i < GBW_TERM_WAIT; i++)); do [[ -z "$(main_pid)" ]] && break; sleep 1; done
  if [[ -n "$(main_pid)" ]]; then
    if why="$(guard_blocks)"; then defer "$why"; fi
    pkill -KILL -U "$UID_" -f "^$(printf '%s' "$BINDIR" | sed 's/[][\.^$*+?(){}|/]/\\&/g')/"; sleep 2
  fi
fi
if why="$(guard_blocks)"; then defer "$why"; fi
record_relaunch
open -g -a "$GBW_APP_PATH"
for ((i = 0; i < GBW_SETTLE; i++)); do
  if probe || { [[ -n "$M" && "$M" != "$OLD" ]] && (( NS >= want )); }; then
    echo 0 >"$STATE/fails"; rm -f "$STATE/cap-notified"; log recovered; echo status=recovered; exit 10
  fi
  sleep 1
done
log FAILED; notify "Could not relaunch $GBW_APP_NAME."; echo status=failed >&2; exit 5
